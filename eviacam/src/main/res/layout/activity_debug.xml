<?xml version="1.0" encoding="utf-8"?>
<!--
 /*
 ** EyeDroid debug screen
 **
 ** Live log viewer plus the real runtime diagnostics.
 */
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/debug_tab_logs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/debug_tab_logs" />

        <Button
            android:id="@+id/debug_tab_diagnostics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/debug_tab_diagnostics" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/debug_log_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/debug_log_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="96dp" />

                <Button
                    android:id="@+id/debug_log_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_pause" />

                <Button
                    android:id="@+id/debug_log_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_clear" />

                <Button
                    android:id="@+id/debug_log_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_share" />

                <Button
                    android:id="@+id/debug_log_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_refresh" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/debug_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#101010"
            android:padding="4dp">

            <TextView
                android:id="@+id/debug_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#B0FFB0"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/debug_diagnostics_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/debug_diagnostics_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>

        <Button
            android:id="@+id/debug_diagnostics_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_refresh" />

        <Button
            android:id="@+id/debug_retry_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_retry_engine" />
    </LinearLayout>

</LinearLayout>
